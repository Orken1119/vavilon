---
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "ТОО Вавилон-Проект — Узаконение недвижимости и перепланировок в Алматы", 
	description = "Профессиональные услуги по оформлению строительных документов, узаконению перепланировок любой сложности, получению АПЗ, сейсмозаключениям и вводу объектов в эксплуатацию в Алматы." 
} = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/favicon.svg" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Фирменная палитра */
		--color-emerald: #133328;
		--color-cream: #FAF8F5;
		--color-gold: #C5A059;
		--color-graphite: #333D39;
		--color-white: #FFFFFF;
		
		/* Полупрозрачные оттенки для эффектов */
		--color-emerald-light: rgba(19, 51, 40, 0.05);
		--color-emerald-medium: rgba(19, 51, 40, 0.1);
		--color-gold-light: rgba(197, 160, 89, 0.15);
		--color-gold-hover: #b48e47;
		--color-graphite-light: rgba(51, 61, 57, 0.7);

		/* Шрифты */
		--font-primary: 'Inter', sans-serif;
		--font-title: 'Montserrat', sans-serif;
		--font-serif: 'Playfair Display', serif; /* для заголовков премиум уровня */
		
		/* Переходы */
		--transition-fast: 0.2s ease;
		--transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		
		/* Тени */
		--shadow-sm: 0 2px 4px rgba(19, 51, 40, 0.04);
		--shadow-md: 0 8px 16px rgba(19, 51, 40, 0.06);
		--shadow-lg: 0 16px 32px rgba(19, 51, 40, 0.1);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		font-family: var(--font-primary);
		background-color: var(--color-cream);
		color: var(--color-graphite);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow-x: hidden;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-title);
		font-weight: 700;
		color: var(--color-emerald);
		line-height: 1.25;
	}

	p {
		line-height: 1.6;
		font-size: 1rem;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: color var(--transition-fast), border-color var(--transition-fast);
	}

	button, input, textarea, select {
		font-family: inherit;
	}

	/* Утилиты и контейнеры */
	.container {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* Премиум-кнопки */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.5rem;
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border-radius: 4px;
		border: 1px solid transparent;
		cursor: pointer;
		transition: all var(--transition-normal);
	}

	.btn-gold {
		background-color: var(--color-gold);
		color: var(--color-emerald);
	}

	.btn-gold:hover {
		background-color: var(--color-gold-hover);
		transform: translateY(-2px);
		box-shadow: 0 4px 12px var(--color-gold-light);
	}

	.btn-emerald {
		background-color: var(--color-emerald);
		color: var(--color-white);
	}

	.btn-emerald:hover {
		background-color: #1a4235;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(19, 51, 40, 0.2);
	}

	.btn-outline {
		background-color: transparent;
		border-color: var(--color-gold);
		color: var(--color-gold);
	}

	.btn-outline:hover {
		background-color: var(--color-gold);
		color: var(--color-emerald);
		transform: translateY(-2px);
	}

	/* Скрывать контент красиво при анимации */
	.fade-in-section {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	.fade-in-section.is-visible {
		opacity: 1;
		transform: none;
	}
</style>
