---
const services = [
	{
		id: "pereplanirovka",
		icon: "🏗️",
		title: "Узаконение перепланировок",
		desc: "Оформление изменений в планировке квартир и коммерческих помещений любой сложности под ключ.",
		details: [
			"Разработка проектной документации",
			"Подготовка технических заключений",
			"Оформление нового техпаспорта",
			"Государственная регистрация изменений"
		]
	},
	{
		id: "apz-project",
		icon: "📋",
		title: "АПЗ и Эскизный проект",
		desc: "Получение разрешений и проектирование объектов, согласованные с управлением урбанистики.",
		details: [
			"Подача онлайн-заявок на e-license.kz",
			"Разработка эскизных и рабочих проектов",
			"Согласование эскизов в МИО",
			"Прохождение экспертизы проектов"
		]
	},
	{
		id: "vvod-exploitation",
		icon: "🔑",
		title: "Акт ввода в эксплуатацию",
		desc: "Юридическое завершение строительства с регистрацией в уполномоченных органах.",
		details: [
			"Заполнение актов приемки объекта",
			"Сбор подписей членов комиссии",
			"Регистрация в Горархитектуре",
			"Регистрация в Департаменте Юстиции"
		]
	},
	{
		id: "pdp-plan",
		icon: "🗺️",
		title: "Планы детальной планировки (ПДП)",
		desc: "Разработка проектов планировки участков в соответствии с генеральным планом Алматы.",
		details: [
			"Сбор необходимого пакета документов",
			"Подача заявлений в гос. инстанции",
			"Проверка соответствия генплану",
			"Внесение изменений в ПДП"
		]
	},
	{
		id: "vivod-fond",
		icon: "🏠",
		title: "Вывод из жилого фонда",
		desc: "Переоборудование квартир на первых этажах под офисы, магазины и коммерческие цели.",
		details: [
			"Оценка перспективы вывода",
			"Организация согласия соседей",
			"Разработка проектов переоборудования",
			"Учет красных линий на топосъемке"
		]
	},
	{
		id: "seismo",
		icon: "🏢",
		title: "Сейсмозаключения",
		desc: "Экспертиза устойчивости и безопасности объектов в сейсмоопасной зоне Алматы.",
		details: [
			"Визуальное и инструментальное обследование",
			"Определение прочности материалов",
			"Оформление официального заключения",
			"Рекомендации по усилению конструкций"
		]
	}
];
---

<section class="services-section" id="services">
	<div class="container">
		<div class="section-header">
			<span class="section-subtitle">Наши компетенции</span>
			<h2 class="section-title">Профессиональные услуги в Алматы</h2>
			<div class="section-divider"></div>
			<p class="section-desc">
				Мы помогаем законно оформить любые изменения в недвижимости и подготовить документы для строительства без очередей и волокиты.
			</p>
		</div>

		<div class="services-grid">
			{services.map((service) => (
				<div class="service-card" id={`service-${service.id}`}>
					<div class="service-icon-wrapper">
						<span class="service-icon">{service.icon}</span>
					</div>
					<h3 class="service-title">{service.title}</h3>
					<p class="service-text">{service.desc}</p>
					
					<div class="service-details-box">
						<span class="details-title">Что входит в услугу:</span>
						<ul class="service-details-list">
							{service.details.map((detail) => (
								<li>
									<span class="check-icon">✓</span>
									<span class="detail-text">{detail}</span>
								</li>
							))}
						</ul>
					</div>

					<a href="#contacts" class="btn btn-outline btn-service" data-service={service.title}>
						Заказать услугу
					</a>
				</div>
			))}
		</div>

		<div class="services-cta">
			<p>Не нашли нужную услугу или возник сложный случай с документами?</p>
			<a href="#contacts" class="btn btn-gold">Получить бесплатный анализ ситуации</a>
		</div>
	</div>
</section>

<style>
	.services-section {
		padding: 6rem 0;
		background-color: var(--color-cream);
		position: relative;
	}

	.section-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 4rem;
	}

	.section-subtitle {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-gold);
		margin-bottom: 0.75rem;
		display: block;
	}

	.section-title {
		font-size: 2.2rem;
		font-weight: 800;
		color: var(--color-emerald);
		margin-bottom: 1rem;
	}

	.section-divider {
		width: 60px;
		height: 3px;
		background-color: var(--color-gold);
		margin: 0.75rem auto 1.5rem;
		border-radius: 2px;
	}

	.section-desc {
		color: var(--color-graphite);
		font-size: 1.05rem;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		margin-bottom: 4rem;
	}

	.service-card {
		background-color: var(--color-white);
		border: 1px solid rgba(19, 51, 40, 0.05);
		border-radius: 8px;
		padding: 2.5rem 2rem;
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow-sm);
		transition: all var(--transition-normal);
		position: relative;
		overflow: hidden;
	}

	.service-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background-color: var(--color-emerald);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-normal);
	}

	.service-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-md);
		border-color: rgba(197, 160, 89, 0.3);
	}

	.service-card:hover::before {
		transform: scaleX(1);
	}

	.service-icon-wrapper {
		width: 60px;
		height: 60px;
		border-radius: 8px;
		background-color: var(--color-emerald-light);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.5rem;
		transition: background-color var(--transition-normal);
	}

	.service-icon {
		font-size: 1.8rem;
	}

	.service-card:hover .service-icon-wrapper {
		background-color: var(--color-gold-light);
	}

	.service-title {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--color-emerald);
		margin-bottom: 1rem;
		line-height: 1.3;
	}

	.service-text {
		font-size: 0.9rem;
		color: var(--color-graphite-light);
		margin-bottom: 1.5rem;
		line-height: 1.6;
		flex-grow: 1;
	}

	.service-details-box {
		margin-bottom: 2rem;
		background-color: var(--color-cream);
		padding: 1rem 1.25rem;
		border-radius: 6px;
		border-left: 2px solid var(--color-gold);
	}

	.details-title {
		font-family: var(--font-title);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-emerald);
		margin-bottom: 0.5rem;
		display: block;
	}

	.service-details-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.service-details-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--color-graphite);
	}

	.check-icon {
		color: var(--color-gold);
		font-weight: bold;
	}

	.btn-service {
		width: 100%;
		font-size: 0.8rem;
		padding: 0.6rem;
		border-color: rgba(19, 51, 40, 0.2);
		color: var(--color-emerald);
	}

	.btn-service:hover {
		border-color: var(--color-gold);
	}

	.services-cta {
		text-align: center;
		background-color: var(--color-emerald);
		color: var(--color-white);
		padding: 3rem 2rem;
		border-radius: 8px;
		box-shadow: var(--shadow-md);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.services-cta p {
		font-size: 1.2rem;
		font-weight: 500;
		max-width: 600px;
	}

	@media (max-width: 992px) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 650px) {
		.services-grid {
			grid-template-columns: 1fr;
		}

		.section-title {
			font-size: 1.8rem;
		}
	}
</style>

<script>
	// Передача выбранной услуги в форму
	const serviceButtons = document.querySelectorAll('.btn-service');
	const messageInput = document.getElementById('client-message') as HTMLTextAreaElement | null;

	if (serviceButtons && messageInput) {
		serviceButtons.forEach(button => {
			button.addEventListener('click', (e) => {
				const serviceName = (e.currentTarget as HTMLElement).getAttribute('data-service');
				if (serviceName) {
					messageInput.value = `Здравствуйте! Меня интересует услуга: "${serviceName}". Хочу проконсультироваться.`;
				}
			});
		});
	}
</script>
