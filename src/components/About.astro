---
---
<section class="about-section" id="about">
	<div class="container about-container">
		<!-- Графический плейсхолдер -->
		<div class="about-visual">
			<div class="about-card-wrapper">
				<div class="about-image-placeholder">
					<div class="placeholder-overlay">
						<div class="experience-badge">
							<span class="exp-years">> 10</span>
							<span class="exp-lbl">Лет опыта</span>
						</div>
					</div>
					<div class="abstract-building-shapes">
						<!-- Декоративные контуры зданий -->
						<div class="shape shape-1"></div>
						<div class="shape shape-2"></div>
						<div class="shape shape-3"></div>
					</div>
				</div>
			</div>
		</div>

		<!-- Текст о компании -->
		<div class="about-content">
			<span class="section-subtitle">О компании</span>
			<h2 class="section-title">ТОО «Вавилон-Проект»</h2>
			<div class="section-divider"></div>
			
			<p class="about-text">
				Мы специализируемся на профессиональном консалтинге в области строительства, архитектуры и недвижимости в городе Алматы. Наша команда объединяет квалифицированных проектировщиков, юристов и экспертов, отлично знающих все нюансы казахстанского законодательства и требования местных исполнительных органов (МИО).
			</p>
			
			<p class="about-text-secondary">
				Ввод индивидуальных жилых домов и коммерческих объектов в эксплуатацию, перепланировки квартир и получение АПЗ — задачи, требующие времени и опыта. Мы берем на себя взаимодействие с государственными органами, проведение экспертиз и подготовку пакетов документов, избавляя вас от бюрократических сложностей.
			</p>

			<div class="about-stats-grid">
				<div class="about-stat-box">
					<span class="stat-value">100%</span>
					<span class="stat-label">Законность и соответствие нормам</span>
				</div>
				<div class="about-stat-box">
					<span class="stat-value">10+</span>
					<span class="stat-label">Лет успешной работы в Алматы</span>
				</div>
				<div class="about-stat-box">
					<span class="stat-value">500+</span>
					<span class="stat-label">Узаконенных объектов</span>
				</div>
			</div>

			<div class="about-highlights">
				<div class="highlight-item">
					<span class="highlight-icon">📄</span>
					<span class="highlight-txt">Официальный договор с фиксацией стоимости услуг</span>
				</div>
				<div class="highlight-item">
					<span class="highlight-icon">⏱️</span>
					<span class="highlight-txt">Соблюдение согласованных сроков</span>
				</div>
				<div class="highlight-item">
					<span class="highlight-icon">🤝</span>
					<span class="highlight-txt">Бесплатная первичная консультация с анализом рисков</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.about-section {
		padding: 6rem 0;
		background-color: var(--color-cream);
	}

	.about-container {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 4rem;
		align-items: center;
	}

	/* Графический блок */
	.about-visual {
		display: flex;
		justify-content: center;
	}

	.about-card-wrapper {
		position: relative;
		width: 100%;
		max-width: 440px;
		aspect-ratio: 1.1;
	}

	.about-image-placeholder {
		position: relative;
		width: 100%;
		height: 100%;
		background-color: var(--color-emerald);
		border: 1px solid rgba(197, 160, 89, 0.2);
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}

	.placeholder-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(19, 51, 40, 0.6) 0%, rgba(19, 51, 40, 0.9) 100%);
		z-index: 2;
		display: flex;
		align-items: flex-end;
		padding: 2rem;
	}

	.experience-badge {
		background-color: var(--color-gold);
		color: var(--color-emerald);
		padding: 1.5rem;
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
		border: 1px solid rgba(250, 248, 245, 0.2);
	}

	.exp-years {
		font-family: var(--font-title);
		font-size: 2.2rem;
		font-weight: 800;
		line-height: 1;
	}

	.exp-lbl {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-top: 0.25rem;
	}

	/* Декоративные очертания домов */
	.abstract-building-shapes {
		position: absolute;
		bottom: 0;
		right: 0;
		width: 100%;
		height: 80%;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		padding-right: 2rem;
		gap: 0.5rem;
		z-index: 1;
	}

	.shape {
		background-color: rgba(197, 160, 89, 0.15);
		border: 1px solid rgba(197, 160, 89, 0.3);
		border-bottom: none;
		border-top-left-radius: 4px;
		border-top-right-radius: 4px;
		width: 60px;
		transition: height var(--transition-normal);
	}

	.shape-1 {
		height: 40%;
	}

	.shape-2 {
		height: 70%;
		background-color: rgba(197, 160, 89, 0.2);
	}

	.shape-3 {
		height: 50%;
	}

	.about-card-wrapper:hover .shape-1 {
		height: 48%;
	}
	.about-card-wrapper:hover .shape-2 {
		height: 78%;
	}
	.about-card-wrapper:hover .shape-3 {
		height: 58%;
	}

	/* Текст о компании */
	.about-content {
		max-width: 650px;
	}

	.section-subtitle {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-gold);
		margin-bottom: 0.75rem;
		display: block;
	}

	.section-title {
		font-size: 2.2rem;
		font-weight: 800;
		color: var(--color-emerald);
		margin-bottom: 1rem;
	}

	.section-divider {
		width: 60px;
		height: 3px;
		background-color: var(--color-gold);
		margin: 0.75rem 0 1.5rem;
		border-radius: 2px;
	}

	.about-text {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-graphite);
		margin-bottom: 1.25rem;
	}

	.about-text-secondary {
		font-size: 0.9rem;
		line-height: 1.7;
		color: var(--color-graphite-light);
		margin-bottom: 2rem;
	}

	.about-stats-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.about-stat-box {
		background-color: var(--color-white);
		border-radius: 6px;
		padding: 1.25rem;
		border: 1px solid rgba(19, 51, 40, 0.05);
		text-align: center;
		box-shadow: var(--shadow-sm);
	}

	.stat-value {
		font-family: var(--font-title);
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--color-gold);
		display: block;
		margin-bottom: 0.25rem;
	}

	.stat-label {
		font-size: 0.7rem;
		color: var(--color-graphite);
		line-height: 1.3;
		display: block;
		font-weight: 600;
	}

	.about-highlights {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border-top: 1px solid rgba(19, 51, 40, 0.1);
		padding-top: 1.5rem;
	}

	.highlight-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.highlight-icon {
		font-size: 1.1rem;
	}

	.highlight-txt {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-emerald);
	}

	@media (max-width: 992px) {
		.about-container {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.about-visual {
			order: 1;
		}

		.about-stats-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.section-title {
			font-size: 1.8rem;
		}
	}
</style>
