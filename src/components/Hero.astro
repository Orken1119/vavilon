---
---
<section class="hero-section">
	<!-- Фоновые декоративные элементы -->
	<div class="hero-bg-overlay"></div>
	<div class="hero-glow hero-glow-1"></div>
	<div class="hero-glow hero-glow-2"></div>

	<div class="container hero-container">
		<div class="hero-content">
			<span class="hero-badge">Строительный консалтинг в Алматы</span>
			<h1 class="hero-title">
				Узаконение недвижимости и оформление <span class="text-gold">строительных документов</span>
			</h1>
			<p class="hero-description">
				ТОО «Вавилон-Проект» берет на себя всю бумажную работу и согласования. Оформим перепланировку, АПЗ, сейсмозаключение и введем объект в эксплуатацию в кратчайшие сроки с юридической гарантией.
			</p>
			
			<div class="hero-actions">
				<a href="#contacts" class="btn btn-gold btn-hero">Бесплатная консультация</a>
				<a href="#services" class="btn btn-outline btn-hero-outline">Наши услуги</a>
			</div>

			<div class="hero-features">
				<div class="hero-feature-item">
					<span class="feature-icon">🛡️</span>
					<div class="feature-text">
						<strong>Официальный договор</strong>
						<span>Полная юридическая ответственность</span>
					</div>
				</div>
				<div class="hero-feature-item">
					<span class="feature-icon">⚡</span>
					<div class="feature-text">
						<strong>Кратчайшие сроки</strong>
						<span>Бережем ваше время и нервы</span>
					</div>
				</div>
				<div class="hero-feature-item">
					<span class="feature-icon">🏢</span>
					<div class="feature-text">
						<strong>Сотни объектов</strong>
						<span>Успешный ввод жилья и коммерции</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Место для премиального изображения (плейсхолдер) -->
		<div class="hero-visual">
			<div class="visual-wrapper">
				<div class="visual-placeholder">
					<!-- Символический премиальный чертеж / абстрактный золотой элемент на темно-зеленом фоне -->
					<div class="abstract-card">
						<div class="card-logo-container">
							<img src="/vavilon_logo.svg" alt="Вавилон-Проект" class="visual-logo" />
						</div>
						<div class="card-line"></div>
						<div class="card-title">Узаконение объектов «под ключ»</div>
						<div class="card-stats">
							<div class="stat-item">
								<span class="stat-num">> 10 лет</span>
								<span class="stat-lbl">Опыта работы</span>
							</div>
							<div class="stat-item">
								<span class="stat-num">100%</span>
								<span class="stat-lbl">Гарантия результата</span>
							</div>
						</div>
					</div>
					<div class="blueprint-lines"></div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-section {
		position: relative;
		background-color: var(--color-emerald);
		padding: 7rem 0 5rem;
		overflow: hidden;
		display: flex;
		align-items: center;
		min-height: calc(100vh - 80px);
	}

	/* Эффект свечения */
	.hero-bg-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 80% 20%, rgba(197, 160, 89, 0.08) 0%, transparent 50%),
		            radial-gradient(circle at 10% 80%, rgba(250, 248, 245, 0.03) 0%, transparent 40%);
		pointer-events: none;
	}

	.hero-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(120px);
		pointer-events: none;
		opacity: 0.15;
	}

	.hero-glow-1 {
		top: -10%;
		right: 10%;
		width: 400px;
		height: 400px;
		background-color: var(--color-gold);
	}

	.hero-glow-2 {
		bottom: -10%;
		left: 5%;
		width: 300px;
		height: 300px;
		background-color: var(--color-white);
	}

	.hero-container {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 4rem;
		align-items: center;
		position: relative;
		z-index: 2;
	}

	.hero-content {
		max-width: 650px;
	}

	.hero-badge {
		display: inline-block;
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-gold);
		background-color: rgba(197, 160, 89, 0.1);
		padding: 0.4rem 1rem;
		border-radius: 50px;
		border: 1px solid rgba(197, 160, 89, 0.2);
		margin-bottom: 1.5rem;
	}

	.hero-title {
		font-size: 2.8rem;
		font-weight: 800;
		color: var(--color-white);
		line-height: 1.2;
		margin-bottom: 1.5rem;
		letter-spacing: -0.01em;
	}

	.text-gold {
		color: var(--color-gold);
		background: linear-gradient(135deg, var(--color-gold) 0%, #ecd09b 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-description {
		font-size: 1.1rem;
		color: rgba(250, 248, 245, 0.8);
		margin-bottom: 2.5rem;
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		gap: 1.25rem;
		margin-bottom: 3.5rem;
	}

	.btn-hero {
		padding: 1rem 2rem;
		font-size: 0.95rem;
	}

	.btn-hero-outline {
		padding: 1rem 2rem;
		font-size: 0.95rem;
		border-color: rgba(250, 248, 245, 0.3);
		color: var(--color-white);
	}

	.btn-hero-outline:hover {
		border-color: var(--color-gold);
		background-color: rgba(197, 160, 89, 0.05);
		color: var(--color-gold);
	}

	.hero-features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		border-top: 1px solid rgba(250, 248, 245, 0.1);
		padding-top: 2rem;
	}

	.hero-feature-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.feature-icon {
		font-size: 1.25rem;
		margin-top: 0.2rem;
	}

	.feature-text {
		display: flex;
		flex-direction: column;
	}

	.feature-text strong {
		color: var(--color-white);
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.feature-text span {
		color: rgba(250, 248, 245, 0.5);
		font-size: 0.7rem;
		margin-top: 0.1rem;
	}

	/* Визуальный элемент / Плейсхолдер */
	.hero-visual {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.visual-wrapper {
		position: relative;
		width: 100%;
		max-width: 440px;
		aspect-ratio: 1;
	}

	.visual-placeholder {
		position: relative;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(51, 61, 57, 0.4) 0%, rgba(19, 51, 40, 0.8) 100%);
		border: 1px solid rgba(197, 160, 89, 0.3);
		border-radius: 12px;
		padding: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: var(--shadow-lg);
		backdrop-filter: blur(5px);
		overflow: hidden;
	}

	/* Эффект сетки чертежа (blueprint) */
	.blueprint-lines {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-size: 20px 20px;
		background-image: 
			linear-gradient(to right, rgba(197, 160, 89, 0.03) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(197, 160, 89, 0.03) 1px, transparent 1px);
		pointer-events: none;
	}

	.abstract-card {
		background: rgba(19, 51, 40, 0.85);
		border: 1px solid var(--color-gold);
		border-radius: 8px;
		padding: 2rem;
		width: 100%;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
		position: relative;
		z-index: 2;
	}

	.card-logo-container {
		display: flex;
		justify-content: center;
		margin-bottom: 1.5rem;
	}

	.visual-logo {
		height: 60px;
		width: auto;
	}

	.card-line {
		height: 1px;
		background: linear-gradient(to right, transparent, var(--color-gold), transparent);
		margin-bottom: 1.5rem;
	}

	.card-title {
		font-family: var(--font-title);
		font-weight: 600;
		color: var(--color-white);
		text-align: center;
		font-size: 1.05rem;
		margin-bottom: 1.5rem;
		letter-spacing: 0.02em;
	}

	.card-stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		text-align: center;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.stat-num {
		font-family: var(--font-title);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-gold);
	}

	.stat-lbl {
		font-size: 0.65rem;
		color: rgba(250, 248, 245, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	@media (max-width: 992px) {
		.hero-container {
			grid-template-columns: 1fr;
			gap: 3rem;
			text-align: center;
		}

		.hero-content {
			max-width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.hero-title {
			font-size: 2.2rem;
		}

		.hero-actions {
			justify-content: center;
		}

		.hero-features {
			width: 100%;
			grid-template-columns: 1fr;
			gap: 1.25rem;
			text-align: left;
			max-width: 400px;
		}

		.hero-visual {
			order: -1;
			width: 100%;
		}
	}

	@media (max-width: 480px) {
		.hero-title {
			font-size: 1.8rem;
		}

		.hero-actions {
			flex-direction: column;
			width: 100%;
			gap: 1rem;
		}

		.btn-hero, .btn-hero-outline {
			width: 100%;
		}
	}
</style>
