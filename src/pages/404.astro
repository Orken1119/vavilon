---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Страница не найдена — ТОО Вавилон-Проект" 
	description="Запрашиваемая страница не найдена на сайте компании ТОО Вавилон-Проект."
>
	<Header />
	
	<main class="error-main">
		<div class="container error-container">
			<div class="error-visual">
				<span class="error-code">404</span>
				<div class="error-line"></div>
			</div>
			
			<div class="error-content">
				<h1 class="error-title">Страница не найдена</h1>
				<p class="error-message">
					Запрашиваемая вами страница не существует или была перемещена. Возможно, вы ввели неверный адрес ссылки.
				</p>
				
				<div class="error-actions">
					<a href="/" class="btn btn-gold">Вернуться на главную</a>
					<a href="/#services" class="btn btn-outline">Наши услуги</a>
				</div>
			</div>
		</div>
	</main>
	
	<Footer />
</Layout>

<style>
	.error-main {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: calc(100vh - 200px);
		background-color: var(--color-cream);
		padding: 4rem 0;
	}

	.error-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 600px;
	}

	.error-visual {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 2rem;
	}

	.error-code {
		font-family: var(--font-title);
		font-size: 8rem;
		font-weight: 800;
		color: var(--color-emerald);
		line-height: 1;
		background: linear-gradient(135deg, var(--color-emerald) 0%, var(--color-gold) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.05em;
	}

	.error-line {
		width: 80px;
		height: 4px;
		background-color: var(--color-gold);
		margin-top: 1rem;
		border-radius: 2px;
	}

	.error-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.error-title {
		font-size: 2.2rem;
		font-weight: 800;
		color: var(--color-emerald);
	}

	.error-message {
		font-size: 1rem;
		color: var(--color-graphite-light);
		line-height: 1.6;
		max-width: 450px;
	}

	.error-actions {
		display: flex;
		gap: 1.25rem;
		margin-top: 1rem;
	}

	@media (max-width: 480px) {
		.error-code {
			font-size: 6rem;
		}

		.error-title {
			font-size: 1.8rem;
		}

		.error-actions {
			flex-direction: column;
			width: 100%;
			gap: 1rem;
		}

		.error-actions .btn {
			width: 100%;
		}
	}
</style>
